# UAPI 管理系统 — 环境变量备忘
# 用于 GitHub Actions（check-feeds.yml）
# 路径：GitHub 仓库 → Settings → Secrets and variables → Actions

# EdgeOne KV 上报地址（抓取结果写入 KV）
EDGEONE_API_URL=https://api.usj.cc/api/update

# 远程订阅源地址（JSON 格式的 feeds 列表）
FEEDS_URL=https://api.usj.cc/api/feeds

# EdgeOne Pages 代理（需口令）
PROXY_FUNCTION_URL=https://api.usj.cc/api/proxy

# 腾讯云 SCF 国内代理（无需口令，纯国内网络）
PROXY_FUNCTION_URL_BACKUP=https://scfapi.usj.cc

# 飞书群机器人 Webhook（通知推送）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxx

# 网站访问口令（EdgeOne API 鉴权用）
SITE_TOKEN=你的口令

# ---- 邮件通知（可选）----
# EMAIL_PROVIDER=resend|custom|smtp
# EMAIL_API_KEY=re_xxxxx
# EMAIL_FROM=UAPI <bot@usj.cc>
# EMAIL_TO=admin@usj.cc
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=xxx@qq.com
# SMTP_PASS=授权码
